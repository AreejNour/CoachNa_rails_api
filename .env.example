# The database shared with the Node API (CoachNa_api). Rails never resets it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coacha

# CoachNa's commission (%) for coaches with none of their own. Must equal the Node API's value.
PLATFORM_COMMISSION_PERCENT=15

# HTTP port for the Rails API (Node uses 3002)
PORT=3003

# Must equal the Node API's value, so each backend accepts the other's access tokens.
JWT_ACCESS_SECRET=change-me-access

# Files are shared with the Node API, which serves coach photos to the client app. This must be
# the Node API's storage folder, or uploads will work here but clients won't see the photos.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../CoachNa_api/.storage
UPLOAD_MAX_BYTES=8000000
# With STORAGE_DRIVER=s3, use the same bucket as the Node API:
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Reads coaches' plan PDFs (plan import). Without it, import answers 502. Never commit a real key.
ANTHROPIC_API_KEY=

# RabbitMQ for push and email (shared with the Node API). Publishing failures are logged, never raised.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Public origin of this Rails app, used in the "set your password" link emailed to coaches that an
# admin creates. Production REQUIRES it (the app refuses to boot without it) and it must be the
# public https origin, e.g. https://api.example.com. The localhost value is for development only.
COACH_PASSWORD_URL_BASE=http://localhost:3003
