<% sub = @subscription %>
<p><%= link_to "← Subscriptions", admin_subscriptions_path %></p>

<h1>Subscription</h1>
<table>
  <tr><th>Status</th><td><%= sub.status.humanize %></td></tr>
  <tr><th>Price</th><td><%= number_to_currency(sub.price_piastres / 100.0, unit: "EGP ", precision: 2) %></td></tr>
  <tr><th>Commission</th><td><%= sub.commission_percent %>% (<%= number_to_currency(sub.commission_piastres / 100.0, unit: "EGP ", precision: 2) %>)</td></tr>
  <tr><th>Starts</th><td><%= sub.starts_at&.strftime("%Y-%m-%d %H:%M") %></td></tr>
  <tr><th>Ends</th><td><%= sub.ends_at&.strftime("%Y-%m-%d %H:%M") %></td></tr>
  <tr><th>Questionnaire submitted</th><td><%= sub.questionnaire_submitted_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td></tr>
  <tr><th>Created</th><td><%= sub.created_at&.strftime("%Y-%m-%d %H:%M") %></td></tr>
</table>

<h2>Client</h2>
<table>
  <tr><th>Name</th><td><%= sub.client.full_name %></td></tr>
  <tr><th>Phone</th><td><%= sub.client.phone %></td></tr>
  <% if sub.client.email.present? %>
    <tr><th>Email</th><td><%= sub.client.email %></td></tr>
  <% end %>
</table>

<h2>Coach</h2>
<table>
  <tr><th>Name</th><td><%= sub.coach.full_name %></td></tr>
  <tr><th>Phone</th><td><%= sub.coach.phone %></td></tr>
</table>

<h2>Package</h2>
<% if sub.coach_package %>
  <table>
    <tr><th>Name</th><td><%= sub.coach_package.name %></td></tr>
    <tr><th>Duration</th><td><%= sub.coach_package.duration_days %> days</td></tr>
    <tr><th>Price</th><td><%= number_to_currency(sub.coach_package.price_piastres / 100.0, unit: "EGP ", precision: 2) %></td></tr>
  </table>
<% else %>
  <p>Package not found.</p>
<% end %>

<h2>Payments</h2>
<% if sub.payments.empty? %>
  <p>No payments recorded.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Amount</th><th>Status</th><th>Provider</th><th>Method</th><th>Reference</th><th>Paid at</th><th>Failure</th></tr>
    </thead>
    <tbody>
      <% sub.payments.order(created_at: :desc).each do |p| %>
        <tr>
          <td><%= number_to_currency(p.amount_piastres / 100.0, unit: "EGP ", precision: 2) %></td>
          <td><%= p.status.humanize %></td>
          <td><%= p.provider %></td>
          <td><%= p[:method] || "—" %></td>
          <td><%= p.provider_ref || "—" %></td>
          <td><%= p.paid_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
          <td><%= p.failure_reason || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
