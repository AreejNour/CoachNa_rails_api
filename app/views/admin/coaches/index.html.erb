<h1>Coaches waiting for review</h1>

<% if @coaches.empty? %>
  <p>No coaches are waiting for review.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Name</th><th>Phone</th><th>Specialties</th><th>Submitted</th></tr>
    </thead>
    <tbody>
      <% @coaches.each do |coach| %>
        <tr>
          <td><%= link_to coach.full_name, admin_coach_path(coach) %></td>
          <td><%= coach.phone %></td>
          <td><%= Array(coach.specialties).join(", ") %></td>
          <td><%= coach.profile_submitted_at&.strftime("%Y-%m-%d %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
