<div class="crumbs"><%= link_to "Coaches", admin_root_path %> › <%= @coach.full_name %></div>

<div class="page-head">
  <div>
    <h1><%= @coach.full_name %></h1>
    <div class="sub">
      <%= status_pill(@coach.status) %>
      <% if @coach.profile_submitted_at %>· submitted <%= @coach.profile_submitted_at.strftime("%b %d, %Y") %><% end %>
    </div>
  </div>
</div>

<div class="detail">
  <div>
    <div class="card">
      <div class="card-head"><h2>Application</h2></div>
      <div class="card-body">
        <div class="field"><span class="k">Phone</span><span class="v"><%= @coach.phone %></span></div>
        <div class="field"><span class="k">Email</span><span class="v"><%= @coach.email %></span></div>
        <div class="field"><span class="k">Specialties</span><span class="v"><%= Array(@coach.specialties).join(", ").presence || "—" %></span></div>
        <div class="field"><span class="k">Years of experience</span><span class="v"><%= @coach.years_experience %></span></div>
        <div class="field"><span class="k">Submitted</span><span class="v"><%= @coach.profile_submitted_at&.strftime("%Y-%m-%d %H:%M") || "—" %></span></div>
        <div class="field"><span class="k">Bio</span><span class="v" style="max-width:320px;font-weight:400"><%= @coach.bio.presence || "—" %></span></div>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Documents</h2></div>
      <% if @documents.empty? %>
        <div class="card-body"><p class="muted" style="padding:10px 0">No documents uploaded.</p></div>
      <% else %>
        <div class="card-body">
          <ul class="doc-list">
            <% @documents.each do |doc| %>
              <li>
                <%= link_to doc.type, admin_coach_document_path(@coach, doc), target: "_blank", rel: "noopener" %>
                <small>(<%= doc.mime_type %>)</small>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2>Admin actions</h2></div>

    <% if @coach.status == "pending_review" %>
      <div class="action-form">
        <%= form_with url: admin_approve_coach_path(@coach), method: :post do |f| %>
          <div class="form-row">
            <%= f.label :commission, "Commission (%)" %>
            <%= f.number_field :commission, step: "any", min: 0, max: 100, required: true %>
          </div>
          <%= f.submit "Approve" %>
        <% end %>
      </div>

      <div class="action-form">
        <%= form_with url: admin_request_changes_coach_path(@coach), method: :post do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "request_changes_reason" %>
            <%= f.text_area :reason, id: "request_changes_reason", required: true %>
          </div>
          <%= f.submit "Request changes" %>
        <% end %>
      </div>

      <div class="action-form">
        <%= form_with url: admin_reject_coach_path(@coach), method: :post,
              data: { confirm: "Reject this coach? This cannot be undone." },
              html: { onsubmit: "return confirm('Reject this coach? This cannot be undone.')" } do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "reject_reason" %>
            <%= f.text_area :reason, id: "reject_reason", required: true %>
          </div>
          <%= f.submit "Reject" %>
        <% end %>
      </div>

    <% elsif @coach.status == "approved" %>
      <div class="action-form">
        <%= form_with url: admin_suspend_coach_path(@coach), method: :post do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "suspend_reason" %>
            <%= f.text_area :reason, id: "suspend_reason", required: true %>
          </div>
          <%= f.submit "Suspend" %>
        <% end %>
      </div>

      <div class="action-form">
        <%= form_with url: admin_deactivate_coach_path(@coach), method: :post,
              data: { confirm: "Deactivate this coach? This cannot be undone." },
              html: { onsubmit: "return confirm('Deactivate this coach? This cannot be undone.')" } do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "deactivate_reason" %>
            <%= f.text_area :reason, id: "deactivate_reason", required: true %>
          </div>
          <%= f.submit "Deactivate" %>
        <% end %>
      </div>

    <% elsif @coach.status == "suspended" %>
      <div class="action-form">
        <%= form_with url: admin_reactivate_coach_path(@coach), method: :post do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "reactivate_reason" %>
            <%= f.text_area :reason, id: "reactivate_reason", required: true %>
          </div>
          <%= f.submit "Reactivate" %>
        <% end %>
      </div>

      <div class="action-form">
        <%= form_with url: admin_deactivate_coach_path(@coach), method: :post,
              data: { confirm: "Deactivate this coach? This cannot be undone." },
              html: { onsubmit: "return confirm('Deactivate this coach? This cannot be undone.')" } do |f| %>
          <div class="form-row">
            <%= f.label :reason, "Reason", for: "deactivate_suspended_reason" %>
            <%= f.text_area :reason, id: "deactivate_suspended_reason", required: true %>
          </div>
          <%= f.submit "Deactivate" %>
        <% end %>
      </div>

    <% else %>
      <div class="card-body"><p class="muted" style="padding:10px 0">No actions available for this coach's current status.</p></div>
    <% end %>
  </div>
</div>
