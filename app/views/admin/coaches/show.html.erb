<div class="crumbs"><%= link_to "Coaches", admin_root_path %> › <%= @coach.full_name %></div>

<div class="page-head">
  <div>
    <h1><%= @coach.full_name %></h1>
    <div class="sub">
      <%= status_pill(@coach.status) %>
      <% if @coach.profile_submitted_at %>· submitted <%= @coach.profile_submitted_at.strftime("%b %d, %Y") %><% end %>
    </div>
  </div>
</div>

<div class="filters" style="margin-bottom:18px">
  <%= link_to "Profile", admin_coach_path(@coach),
        class: "pill #{'active' if @tab == 'profile'}" %>
  <%= link_to "Clients", admin_coach_path(@coach, tab: "clients"),
        class: "pill #{'active' if @tab == 'clients'}" %>
</div>

<%= render @tab == "clients" ? "clients" : "profile" %>
