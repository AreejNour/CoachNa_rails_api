<% if @client.status == "active" %>
  <div class="action-form">
    <%= form_with url: admin_suspend_client_path(@client), method: :post do |f| %>
      <%= f.submit "Suspend" %>
    <% end %>
  </div>

  <div class="action-form">
    <%= form_with url: admin_deactivate_client_path(@client), method: :post,
          html: { onsubmit: "return confirm('Deactivate this client? This cannot be undone.')" } do |f| %>
      <%= f.submit "Deactivate" %>
    <% end %>
  </div>

<% elsif @client.status == "suspended" %>
  <div class="action-form">
    <%= form_with url: admin_reactivate_client_path(@client), method: :post do |f| %>
      <%= f.submit "Reactivate" %>
    <% end %>
  </div>

  <div class="action-form">
    <%= form_with url: admin_deactivate_client_path(@client), method: :post,
          html: { onsubmit: "return confirm('Deactivate this client? This cannot be undone.')" } do |f| %>
      <%= f.submit "Deactivate" %>
    <% end %>
  </div>

<% else %>
  <div class="card-body"><p class="muted" style="padding:10px 0">No actions available for this client's current status.</p></div>
<% end %>
