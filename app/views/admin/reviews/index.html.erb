<div class="page-head">
  <div>
    <h1>Reviews</h1>
    <div class="sub">Waiting for moderation</div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Moderation queue</h2>
    <% unless @reviews.empty? %><span class="pill warn"><%= @reviews.size %> pending</span><% end %>
  </div>

  <% if @reviews.empty? %>
    <div class="card-body"><p class="muted" style="padding:14px 0">No reviews are pending moderation.</p></div>
  <% else %>
    <table>
      <thead>
        <tr><th>Coach</th><th>Client</th><th>Rating</th><th>Body</th><th>Submitted</th><th>Photos</th><th></th></tr>
      </thead>
      <tbody>
        <% @reviews.each do |review| %>
          <tr>
            <td class="name"><%= review.coach.full_name %></td>
            <td><%= review.client.full_name %></td>
            <td><span class="stars"><%= "★" * review.rating.to_i %></span><span class="muted"><%= "★" * (5 - review.rating.to_i) %></span></td>
            <td><small><%= truncate(review.body.to_s, length: 80) %></small></td>
            <td><small><%= review.created_at&.strftime("%b %d · %H:%M") %></small></td>
            <td><%= review.review_photos.size %></td>
            <td><%= link_to "Review", admin_review_path(review) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
