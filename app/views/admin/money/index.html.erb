<% t = @overview.totals %>
<% egp = ->(piastres) { number_to_currency(piastres / 100.0, unit: "EGP ", precision: 2) } %>

<div class="page-head">
  <div>
    <h1>Money</h1>
    <div class="sub">
      From <%= t.subscription_count %> paid subscription<%= "s" unless t.subscription_count == 1 %>
      across <%= t.coach_count %> coach<%= "es" unless t.coach_count == 1 %>.
    </div>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="label">Gross income</div><div class="num"><%= egp.(t.gross_piastres) %></div></div>
  <div class="stat"><div class="label">CoachNa commission</div><div class="num"><%= egp.(t.commission_piastres) %></div></div>
  <div class="stat"><div class="label">Owed to coaches</div><div class="num"><%= egp.(t.net_piastres) %></div></div>
</div>

<div class="card">
  <div class="card-head"><h2>By coach</h2></div>
  <% if @overview.coaches.empty? %>
    <div class="card-body"><p class="muted" style="padding:14px 0">No paid subscriptions yet.</p></div>
  <% else %>
    <table>
      <thead>
        <tr><th>Coach</th><th class="right">Income</th><th class="right">CoachNa commission</th><th class="right">Owed</th><th class="right">Paid subs</th></tr>
      </thead>
      <tbody>
        <% @overview.coaches.each do |c| %>
          <tr>
            <td class="name"><%= c.coach_name %></td>
            <td class="right amount"><%= egp.(c.gross_piastres) %></td>
            <td class="right amount"><%= egp.(c.commission_piastres) %></td>
            <td class="right amount"><%= egp.(c.net_piastres) %></td>
            <td class="right"><%= c.subscription_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
