<style>
  .login-wrap{min-height:100vh;display:grid;place-items:center;
      background:radial-gradient(1200px 500px at 70% -10%,var(--brand-tint),var(--bg))}
  .login-card{background:#fff;border:1px solid var(--line);border-radius:16px;
      box-shadow:0 10px 30px rgba(16,24,40,.08);width:360px;padding:30px 28px}
  .login-card .dot{width:40px;height:40px;border-radius:11px;background:var(--brand);
      display:grid;place-items:center;color:#fff;font-size:20px;margin-bottom:16px}
  .login-card h1{font-size:20px;margin:0 0 4px}
  .login-card .lead{margin:0 0 10px;color:var(--muted)}
  .login-card input[type=submit]{width:100%;justify-content:center;margin-top:20px;padding:11px}
</style>

<div class="login-wrap">
  <div class="login-card">
    <div class="dot">🥗</div>
    <h1>CoachNa Admin</h1>
    <p class="lead">Sign in to manage coaches, reviews &amp; payouts.</p>

    <%= form_with url: admin_login_path, method: :post do |f| %>
      <div class="form-row">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "username" %>
      </div>
      <div class="form-row">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>
      <%= f.submit "Sign in" %>
    <% end %>
  </div>
</div>
