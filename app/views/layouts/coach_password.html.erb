<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="referrer" content="no-referrer">
  <title>CoachNa</title>
  <%= csrf_meta_tags %>
  <style>
    :root{--brand:#0F7A63;--brand-dark:#0B5F4D;--bg:#F6F7F8;--ink:#1A1C1B;--muted:#6B7472;--line:#E6E9E8;--danger:#C5482F;--danger-bg:#FBEDE9}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.5}
    main{max-width:420px;margin:0 auto;padding:32px 16px}
    .brand{text-align:center;font-size:26px;font-weight:700;color:var(--brand);margin-bottom:20px}
    .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;box-shadow:0 1px 3px rgba(16,24,40,.06)}
    h1{font-size:19px;margin:0 0 4px}
    .ar{direction:rtl;text-align:right;color:var(--muted);font-size:15px;margin:0 0 14px}
    label{display:block;font-weight:600;font-size:14px;margin:14px 0 6px}
    label span{color:var(--muted);font-weight:400}
    input[type=password]{width:100%;padding:12px;font-size:16px;border:1px solid var(--line);border-radius:10px;font-family:inherit}
    button{width:100%;margin-top:20px;padding:13px;font-size:16px;font-weight:600;color:#fff;background:var(--brand);border:0;border-radius:10px;cursor:pointer}
    button:hover{background:var(--brand-dark)}
    .error{background:var(--danger-bg);color:var(--danger);border-radius:10px;padding:10px 12px;font-size:14px;margin-bottom:6px}
    .error .ar{color:var(--danger);margin:2px 0 0;font-size:14px}
    .hint{color:var(--muted);font-size:13px;margin-top:6px}
  </style>
</head>
<body>
  <main>
    <div class="brand">CoachNa</div>
    <div class="card"><%= yield %></div>
  </main>
</body>
</html>
