<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CoachNa Admin</title>
  <%= csrf_meta_tags %>
  <style>
    :root{
      --brand:#0F7A63; --brand-dark:#0B5F4D; --brand-tint:#E7F2EE;
      --bg:#F6F7F8; --card:#fff; --ink:#1A1C1B; --muted:#6B7472;
      --line:#E6E9E8; --danger:#C5482F; --danger-bg:#FBEDE9; --danger-line:#F0CcC3;
      --warn:#9A6B00; --warn-bg:#FBF3DF; --ok:#0F7A63; --ok-bg:#E7F2EE;
      --radius:12px; --shadow:0 1px 2px rgba(16,24,40,.04),0 1px 3px rgba(16,24,40,.06);
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
         background:var(--bg);color:var(--ink);font-size:14px;line-height:1.5}
    a{color:inherit;text-decoration:none}
    h1{font-size:22px;letter-spacing:-.01em;margin:0}
    h2{font-size:15px;margin:0}

    /* ---- shell ---- */
    .shell{display:grid;grid-template-columns:232px 1fr;min-height:100vh}
    aside{background:var(--brand-dark);color:#fff;display:flex;flex-direction:column;
          padding:18px 14px;position:sticky;top:0;height:100vh}
    .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px;padding:6px 10px 18px}
    .brand .dot{width:26px;height:26px;border-radius:8px;background:var(--brand);
         display:grid;place-items:center;font-size:14px}
    .brand small{font-weight:500;color:#A9C3BB;font-size:12px}
    nav.side{display:flex;flex-direction:column;gap:2px;flex:1}
    nav.side a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:9px;
         color:#D8E6E1;font-weight:500}
    nav.side a .ic{width:18px;text-align:center;opacity:.9}
    nav.side a:hover{background:rgba(255,255,255,.08);color:#fff}
    nav.side a.active{background:var(--brand);color:#fff;box-shadow:var(--shadow)}
    .userbox{border-top:1px solid rgba(255,255,255,.14);padding-top:14px;margin-top:10px;
         display:flex;align-items:center;gap:10px}
    .avatar{width:32px;height:32px;border-radius:50%;background:var(--brand);
         display:grid;place-items:center;font-weight:700;font-size:13px;flex:none}
    .userbox .meta{font-size:12px;line-height:1.3;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
    .userbox .meta small{color:#A9C3BB}
    .userbox form{margin:0 0 0 auto}
    .userbox button{background:transparent;border:0;color:#A9C3BB;font-size:13px;cursor:pointer;padding:4px}
    .userbox button:hover{color:#fff}

    main{padding:30px 34px;max-width:1100px}

    /* ---- header / breadcrumb ---- */
    .page-head{display:flex;align-items:flex-end;justify-content:space-between;
         gap:16px;margin-bottom:22px;flex-wrap:wrap}
    .page-head .sub{color:var(--muted);margin-top:4px}
    .crumbs{color:var(--muted);font-size:12.5px;margin-bottom:8px}
    .crumbs a{color:var(--brand);font-weight:600}

    /* ---- flash ---- */
    .flash{padding:11px 15px;border-radius:9px;margin-bottom:18px;font-weight:500}
    .flash.notice{background:var(--ok-bg);color:var(--ok)}
    .flash.alert{background:var(--danger-bg);color:var(--danger)}
    .flash.warn{background:var(--warn-bg);color:var(--warn)}

    /* ---- stat cards ---- */
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px}
    .stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
          padding:16px 18px;box-shadow:var(--shadow)}
    .stat .label{color:var(--muted);font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
    .stat .num{font-size:24px;font-weight:700;margin-top:6px}
    .stat .meta{font-size:12px;color:var(--muted);margin-top:2px}

    /* ---- card + table ---- */
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
          box-shadow:var(--shadow);overflow:hidden;margin-bottom:20px}
    .card .card-head{display:flex;align-items:center;justify-content:space-between;
          gap:12px;padding:15px 18px;border-bottom:1px solid var(--line)}
    .card .card-body{padding:6px 18px}
    table{width:100%;border-collapse:collapse}
    th{text-align:left;font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;
         color:var(--muted);font-weight:600;padding:11px 18px;background:#FAFBFB;border-bottom:1px solid var(--line)}
    td{padding:13px 18px;border-bottom:1px solid var(--line);vertical-align:middle}
    tbody tr:last-child td{border-bottom:none}
    tbody tr:hover{background:#FAFBFB}
    td.name,td .name{font-weight:600}
    td a{color:var(--brand);font-weight:600}
    td small,.muted{color:var(--muted)}
    .right{text-align:right}
    .amount{font-variant-numeric:tabular-nums;font-weight:600}
    .stars{color:#E4A11B;letter-spacing:1px}

    /* ---- pills ---- */
    .pill{display:inline-flex;align-items:center;font-size:12px;font-weight:600;
         padding:3px 10px;border-radius:20px;white-space:nowrap}
    .pill.ok{background:var(--ok-bg);color:var(--ok)}
    .pill.warn{background:var(--warn-bg);color:var(--warn)}
    .pill.danger{background:var(--danger-bg);color:var(--danger)}
    .pill.muted{background:#EEF1F0;color:var(--muted)}

    /* ---- filter tabs + search ---- */
    .filters{display:flex;flex-wrap:wrap;gap:6px}
    .filters .pill{background:#F3F5F4;color:var(--muted);cursor:pointer;text-decoration:none;
         padding:5px 12px;border:1px solid transparent}
    .filters .pill:hover{background:#EBEEED}
    .filters .pill.active{background:#fff;color:var(--ink);border-color:var(--line);font-weight:700}
    .filters .pill .count{margin-left:6px;font-weight:700;opacity:.65}
    .search-form{display:flex;gap:7px;align-items:center}
    .search-form input[type=search]{border:1px solid var(--line);border-radius:9px;
         padding:7px 11px;font-size:13px;font-family:inherit;min-width:220px}
    .search-form input[type=submit]{border:1px solid var(--line);background:#fff;color:var(--ink);
         padding:7px 14px;border-radius:9px;font-weight:600;font-size:13px;cursor:pointer;font-family:inherit}
    .search-form input[type=submit]:hover{background:#FAFBFB}

    /* ---- buttons ---- */
    .btn{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);
         background:#fff;color:var(--ink);padding:8px 14px;border-radius:9px;font-weight:600;
         font-size:13px;cursor:pointer;font-family:inherit}
    .btn:hover{background:#FAFBFB}
    .btn.primary{background:var(--brand);border-color:var(--brand);color:#fff}
    .btn.primary:hover{background:var(--brand-dark)}
    .btn.danger{color:var(--danger);border-color:var(--danger-line)}
    .btn.danger:hover{background:var(--danger-bg)}

    /* ---- definition rows ---- */
    .detail{display:grid;grid-template-columns:1.6fr 1fr;gap:18px;align-items:start}
    .field{display:flex;justify-content:space-between;gap:20px;padding:11px 0;border-bottom:1px solid var(--line)}
    .field:last-child{border-bottom:none}
    .field .k{color:var(--muted)}
    .field .v{font-weight:600;text-align:right}

    /* ---- forms ---- */
    .form-row{display:block;margin:0 0 14px}
    label{display:block;font-size:13px;font-weight:600;margin:0 0 6px;color:var(--ink)}
    input[type=text],input[type=email],input[type=password],input[type=number],
    input[type=date],input[type=datetime-local],select,textarea{
         width:100%;border:1px solid var(--line);border-radius:9px;padding:10px 12px;
         font-size:14px;font-family:inherit;color:var(--ink);background:#fff}
    input[type=date],input[type=datetime-local]{cursor:pointer}
    input[type=date]::-webkit-calendar-picker-indicator,
    input[type=datetime-local]::-webkit-calendar-picker-indicator{
         cursor:pointer;opacity:.65;padding:4px;border-radius:6px}
    input[type=date]::-webkit-calendar-picker-indicator:hover,
    input[type=datetime-local]::-webkit-calendar-picker-indicator:hover{opacity:1;background:var(--brand-tint)}
    .form-pair{display:flex;gap:10px;flex-wrap:wrap}
    .form-pair > div{flex:1;min-width:200px}
    textarea{min-height:76px;resize:vertical}
    input:focus,select:focus,textarea:focus{outline:2px solid var(--brand-tint);border-color:var(--brand)}
    .filters{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
    .filters input[type=text]{min-width:240px;width:auto}
    .filters select{width:auto}
    input[type=submit]{display:inline-flex;align-items:center;border:1px solid var(--brand);
         background:var(--brand);color:#fff;padding:9px 16px;border-radius:9px;font-weight:600;
         font-size:13px;cursor:pointer;font-family:inherit}
    input[type=submit]:hover{background:var(--brand-dark)}

    /* action-form stack (coach / review moderation) */
    .action-form{padding:16px 18px;border-top:1px solid var(--line)}
    .action-form:first-child{border-top:none}
    .action-form .label-title{font-weight:700;margin-bottom:10px}
    .doc-list{list-style:none;margin:0;padding:0}
    .doc-list li{padding:9px 0;border-bottom:1px solid var(--line)}
    .doc-list li:last-child{border-bottom:none}
    /* action menu + input dialog */
    .action-menu{position:relative;display:inline-block}
    .action-menu>summary{list-style:none;cursor:pointer}
    .action-menu>summary::-webkit-details-marker{display:none}
    .action-panel{position:absolute;right:0;top:calc(100% + 4px);z-index:20;min-width:180px;
         background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
         box-shadow:0 8px 24px rgba(16,24,40,.12);padding:6px}
    .action-panel form{margin:0}
    .action-item{display:block;width:100%;text-align:left;background:none;border:0;border-radius:8px;
         padding:8px 12px;font:inherit;font-weight:600;color:var(--ink);cursor:pointer}
    .action-item:hover{background:#F3F5F4}
    .action-item.danger{color:var(--danger)}
    .action-item.danger:hover{background:var(--danger-bg)}
    .action-empty{padding:8px 12px;margin:0}
    .action-dialog{border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);
         padding:20px;width:min(440px,92vw);background:var(--card);color:var(--ink)}
    .action-dialog::backdrop{background:rgba(16,24,40,.45)}
    .action-dialog h3{margin:0 0 12px}
    .dialog-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:14px}
  </style>
</head>
<body>
  <% if current_admin %>
    <div class="shell">
      <aside>
        <div class="brand"><span class="dot">🥗</span> CoachNa <small>Admin</small></div>
        <nav class="side">
          <%= link_to admin_root_path, class: ("active" if admin_nav_active?(:coaches)) do %>
            <span class="ic">👥</span> Coaches
          <% end %>
          <%= link_to admin_clients_path, class: ("active" if admin_nav_active?(:clients)) do %>
            <span class="ic">🧑</span> Clients
          <% end %>
          <%= link_to admin_reviews_path, class: ("active" if admin_nav_active?(:reviews)) do %>
            <span class="ic">⭐</span> Reviews
          <% end %>
          <%= link_to admin_subscriptions_path, class: ("active" if admin_nav_active?(:subscriptions)) do %>
            <span class="ic">📄</span> Subscriptions
          <% end %>
          <%= link_to admin_money_path, class: ("active" if admin_nav_active?(:money)) do %>
            <span class="ic">💰</span> Money
          <% end %>
          <%= link_to admin_promo_codes_path, class: ("active" if admin_nav_active?(:promo_codes)) do %>
            <span class="ic">🏷️</span> Promo codes
          <% end %>
        </nav>
        <div class="userbox">
          <div class="avatar"><%= current_admin.email.to_s[0]&.upcase %></div>
          <div class="meta"><%= current_admin.name %><br><small><%= current_admin.email %></small></div>
          <%= button_to "Log out", admin_logout_path, method: :delete %>
        </div>
      </aside>
      <main>
        <% if flash[:notice] %><div class="flash notice" role="status"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert] %><div class="flash alert" role="alert"><%= flash[:alert] %></div><% end %>
        <%= yield %>
      </main>
    </div>
  <% else %>
    <% if flash[:notice] %><div class="flash notice" role="status"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="flash alert" role="alert"><%= flash[:alert] %></div><% end %>
    <%= yield %>
  <% end %>
  <script>
    document.addEventListener("click", function (e) {
      var t = e.target.closest("[data-dialog]");
      if (t) {
        var menu = t.closest("details");
        if (menu) menu.open = false;
        var d = document.getElementById(t.getAttribute("data-dialog"));
        if (d) d.showModal();
        return;
      }
      var c = e.target.closest("[data-close-dialog]");
      if (c) { c.closest("dialog").close(); return; }
      document.querySelectorAll("details.action-menu[open]").forEach(function (m) {
        if (!m.contains(e.target)) m.open = false;
      });
    });
  </script>
</body>
</html>
